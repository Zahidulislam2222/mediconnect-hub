# Public Vite build configuration. Values prefixed VITE_ are bundled into the client and must
# never contain secrets. Replace example.invalid/placeholder values per environment.
# Service *_BACKUP URLs are optional: leave blank to disable read failover.
# A nonblank backup must be a valid URL; writes are never retried against it.

VITE_ADMIN_SERVICE_URL_EU=https://admin-eu.example.invalid
VITE_ADMIN_SERVICE_URL_EU_BACKUP=https://admin-eu-backup.example.invalid
VITE_ADMIN_SERVICE_URL_US=https://admin-us.example.invalid
VITE_ADMIN_SERVICE_URL_US_BACKUP=https://admin-us-backup.example.invalid
VITE_AWS_REGION_EU=eu-central-1
VITE_AWS_REGION_US=us-east-1
VITE_BOOKING_SERVICE_URL_EU=https://booking-eu.example.invalid
VITE_BOOKING_SERVICE_URL_EU_BACKUP=https://booking-eu-backup.example.invalid
VITE_BOOKING_SERVICE_URL_US=https://booking-us.example.invalid
VITE_BOOKING_SERVICE_URL_US_BACKUP=https://booking-us-backup.example.invalid
VITE_COGNITO_CLIENT_ADMIN_EU=replace-with-public-client-id
VITE_COGNITO_CLIENT_ADMIN_US=replace-with-public-client-id
VITE_COGNITO_CLIENT_DOCTOR_EU=replace-with-public-client-id
VITE_COGNITO_CLIENT_DOCTOR_US=replace-with-public-client-id
VITE_COGNITO_CLIENT_PATIENT_EU=replace-with-public-client-id
VITE_COGNITO_CLIENT_PATIENT_US=replace-with-public-client-id
VITE_COGNITO_CLIENT_STAFF_EU=replace-with-public-client-id
VITE_COGNITO_CLIENT_STAFF_US=replace-with-public-client-id
VITE_COGNITO_IDENTITY_POOL_ID_EU=replace-with-public-identity-pool-id
VITE_COGNITO_IDENTITY_POOL_ID_US=replace-with-public-identity-pool-id
VITE_COGNITO_USER_POOL_ID_EU=replace-with-public-user-pool-id
VITE_COGNITO_USER_POOL_ID_US=replace-with-public-user-pool-id
VITE_COMMUNICATION_SERVICE_URL_EU=https://communication-eu.example.invalid
VITE_COMMUNICATION_SERVICE_URL_EU_BACKUP=https://communication-eu-backup.example.invalid
VITE_COMMUNICATION_SERVICE_URL_US=https://communication-us.example.invalid
VITE_COMMUNICATION_SERVICE_URL_US_BACKUP=https://communication-us-backup.example.invalid
VITE_COMMUNICATION_WS_URL_EU=wss://communication-eu.example.invalid
VITE_COMMUNICATION_WS_URL_US=wss://communication-us.example.invalid
VITE_DOCTOR_SERVICE_URL_EU=https://doctor-eu.example.invalid
VITE_DOCTOR_SERVICE_URL_EU_BACKUP=https://doctor-eu-backup.example.invalid
VITE_DOCTOR_SERVICE_URL_US=https://doctor-us.example.invalid
VITE_DOCTOR_SERVICE_URL_US_BACKUP=https://doctor-us-backup.example.invalid
VITE_PATIENT_SERVICE_URL=https://patient.example.invalid
VITE_PATIENT_SERVICE_URL_EU=https://patient-eu.example.invalid
VITE_PATIENT_SERVICE_URL_EU_BACKUP=https://patient-eu-backup.example.invalid
VITE_PATIENT_SERVICE_URL_US=https://patient-us.example.invalid
VITE_PATIENT_SERVICE_URL_US_BACKUP=https://patient-us-backup.example.invalid
VITE_S3_DOCTOR_DATA_BUCKET_EU=replace-with-public-bucket-name
VITE_S3_DOCTOR_DATA_BUCKET_US=replace-with-public-bucket-name
VITE_S3_EHR_RECORDS_BUCKET_EU=replace-with-public-bucket-name
VITE_S3_EHR_RECORDS_BUCKET_US=replace-with-public-bucket-name
VITE_S3_PATIENT_DATA_BUCKET_EU=replace-with-public-bucket-name
VITE_S3_PATIENT_DATA_BUCKET_US=replace-with-public-bucket-name
VITE_STAFF_SERVICE_URL_EU=https://staff-eu.example.invalid
VITE_STAFF_SERVICE_URL_EU_BACKUP=https://staff-eu-backup.example.invalid
VITE_STAFF_SERVICE_URL_US=https://staff-us.example.invalid
VITE_STAFF_SERVICE_URL_US_BACKUP=https://staff-us-backup.example.invalid
# This value is shipped to browsers and cannot be treated as a secret cryptographic key.
VITE_STRAPI_API_URL=https://cms.example.invalid
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional request timeouts in milliseconds. Omit to use src/config/http-defaults.json.
VITE_API_PRIMARY_TIMEOUT_MS=5000
VITE_API_BACKUP_TIMEOUT_MS=15000
VITE_API_AI_TIMEOUT_MS=30000

# Native Socket.IO monitoring endpoints; these are not the API Gateway chat sockets.
VITE_MONITORING_SOCKET_URL_US=https://monitoring-us.example.invalid
VITE_MONITORING_SOCKET_URL_EU=https://monitoring-eu.example.invalid
