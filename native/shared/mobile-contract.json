{
  "appointments": {
    "service": "booking",
    "path": "/appointments",
    "query": {
      "patient": "patientId",
      "doctor": "doctorId"
    },
    "listKeys": [
      "appointments",
      "existingBookings",
      "data"
    ]
  },
  "profiles": {
    "patient": {
      "service": "patient",
      "readPath": "/me",
      "appendSubject": false,
      "createPath": "/register-patient",
      "subjectField": "patientId"
    },
    "doctor": {
      "service": "doctor",
      "readPath": "/doctors",
      "appendSubject": true,
      "createPath": "/register-doctor",
      "subjectField": "doctorId"
    }
  },
  "cancellation": {
    "path": "/appointments/cancel",
    "cancellableStatuses": [
      "CONFIRMED"
    ],
    "cancelledStatuses": [
      "CANCELLED"
    ],
    "maxLookupPages": 20
  },
  "patientSettings": {
    "updatePath": "/patients",
    "maxNameLength": 200
  },
  "patientExport": {
    "path": "/me/export",
    "collections": [
      "patient",
      "appointments",
      "vitals",
      "allergies",
      "immunizations",
      "carePlans",
      "prescriptions",
      "labOrders",
      "referrals",
      "consentLedger",
      "transactions",
      "reconciliations",
      "chatHistory",
      "sdohAssessments",
      "healthRecords",
      "eligibilityChecks",
      "priorAuths",
      "emergencyAccessLogs",
      "graphData",
      "videoSessions",
      "bluebuttonConnections",
      "reminders",
      "hl7Messages",
      "mpiLinks",
      "ecrReports",
      "elrReports",
      "dicomStudies",
      "symptomLogs",
      "bigqueryVitals"
    ],
    "ownerCollection": "patient",
    "maxJsonDepth": 64
  }
}
